# Example secrets for the Construction Draw Tracker — placeholder values only.
# Local runs: copy this file to .streamlit/secrets.toml (git-ignored) and fill it in.
# Streamlit Community Cloud: paste the filled-in sections into the app's Settings -> Secrets.
# Never commit real values.

[salesforce]
# OAuth sign-in (each person logs in with their own Salesforce account).
# redirect_uri must match a callback URL approved in the Salesforce connected app character for character (a
# trailing slash counts), so copy it from the working app's secrets. While only the original deployment is approved,
# every deployment keeps redirect_uri pointed at it; that deployment relays logins (see [relay] below).
client_id     = "YOUR_CONNECTED_APP_CONSUMER_KEY"
client_secret = "YOUR_CONNECTED_APP_CONSUMER_SECRET"
redirect_uri  = "https://hudgeneratorapptest.streamlit.app"
auth_host     = "https://login.salesforce.com"    # or your My Domain URL, e.g. https://yourdomain.my.salesforce.com
# scope  = "api refresh_token"                    # optional (this is the default)
# prompt = "login"                                # optional (this is the default)

# --- Or, one shared Salesforce login with no callback URL (comment out the OAuth keys above):
# username       = "you@example.com"
# password       = "YOUR_SALESFORCE_PASSWORD"
# security_token = "YOUR_SECURITY_TOKEN"
# domain         = "login"

[landgorilla]
user     = "you@example.com"
password = "YOUR_LAND_GORILLA_PASSWORD"
verify   = true
# template_id = "437"                             # optional: Land Gorilla pipeline template for loan progress

# [relay] belongs ONLY in the old app's Streamlit Cloud secrets — the deployment whose URL is the approved
# Salesforce callback (https://hudgeneratorapptest.streamlit.app, main file draw_dashboard.py). It forwards Salesforce
# logins (state starting "cdt") to the new deployment (main file streamlit_app.py), which finishes them. Never add it
# to the new app (that app ignores it anyway), and leave it out of local runs.
# [relay]
# forward_to = "https://construction-draw-tracker.streamlit.app/"
